# Copy this file to `.env` next to compose.yaml and adjust the values.
# `.env` is gitignored — real credentials/values must never be committed.
# The compose file uses these defaults if `.env` is absent (unsafe for the
# password — always set one).

# UID/GID the go-librespot daemon containers run as (non-root).
# PGID is the SHARED FIFO group: the daemon writes the FIFOs via this group
# and the Lavalink plugin JVM reads them via group permissions. The Lavalink
# image's user is `lavalink` with uid/gid 322 (verified 2026-08-28), so the
# default PGID must stay 322 unless you also override the Lavalink container
# user in compose.yaml.
GO_LIBRESPOT_PUID=1000
GO_LIBRESPOT_PGID=322

# Lavalink REST/WS password — CHANGE THIS to a long random value.
LAVALINK_PASSWORD=changeme

# Host port for the Lavalink REST/WS API (your bot connects to this).
# This is the ONLY port the stack publishes. go-librespot is never exposed.
LAVALINK_PORT=2333
